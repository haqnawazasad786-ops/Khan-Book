<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Khan Book - App</title>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #006400;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding-bottom: 70px;
        }

        .app-container {
            width: 100%;
            max-width: 400px;
            background: linear-gradient(135deg, #006400, #004d00);
            min-height: 100vh;
            position: relative;
            display: flex;
            flex-direction: column;
            padding: 20px;
            overflow-x: hidden;
        }

        .screen {
            display: none;
            flex-direction: column;
            flex: 1;
        }

        .screen.active {
            display: flex;
        }

        /* Top Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .user-greeting {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            background-color: #e3f2fd;
            color: #006400;
            font-weight: bold;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            font-size: 18px;
        }

        .greeting-text {
            font-size: 16px;
            font-weight: bold;
        }

        .notification-icon {
            font-size: 20px;
            cursor: pointer;
        }

        .welcome-back {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            margin: 15px 0;
        }

        /* User Info Card */
        .info-card {
            background: linear-gradient(135deg, #008000, #004d00);
            border-radius: 15px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            position: relative;
            margin-bottom: 15px;
        }

        .card-logo {
            font-style: italic;
            font-weight: bold;
            font-size: 24px;
            margin-bottom: 10px;
        }

        .whatsapp-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 24px;
            color: #25D366;
            cursor: pointer;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 12px 0;
            font-size: 15px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 8px;
        }

        .info-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .copy-btn {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 16px;
        }

        /* Ticker */
        .ticker-container {
            background-color: #004d00;
            padding: 8px 0;
            border-radius: 8px;
            overflow: hidden;
            white-space: nowrap;
            margin-bottom: 15px;
        }

        .ticker-text {
            display: inline-block;
            animation: ticker 15s linear infinite;
            font-size: 14px;
            color: #ffffff;
            font-weight: bold;
        }

        @keyframes ticker {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        /* Action Grid */
        .action-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 15px;
        }

        .action-card {
            background: linear-gradient(135deg, #85bb65, #558b2f);
            padding: 20px;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 120px;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            border: none;
            text-align: left;
        }

        .action-card.withdraw {
            background: linear-gradient(135deg, #6c8a73, #3f5e4b);
        }

        .action-card i {
            font-size: 22px;
            color: #004d00;
        }

        .action-card.withdraw i {
            color: #d4edda;
        }

        .action-card span {
            font-size: 18px;
            font-weight: bold;
            color: #003300;
        }

        .action-card.withdraw span {
            color: white;
        }

        /* Transactions Section */
        .transactions-section {
            background: linear-gradient(135deg, #85bb65, #558b2f);
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 20px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: #003300;
            font-weight: bold;
            font-size: 16px;
            margin-bottom: 10px;
        }

        .see-all {
            font-size: 12px;
            color: #003300;
            text-decoration: none;
            cursor: pointer;
        }

        .transaction-item {
            background: rgba(255, 255, 255, 0.2);
            padding: 10px;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 13px;
            color: #003300;
            font-weight: bold;
        }

        /* Withdraw Flow Styles */
        .sub-header {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .form-card {
            background: #d4edda;
            color: #003300;
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 15px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }

        .form-control {
            width: 100%;
            background: #e8f5e9;
            border: 1px solid #85bb65;
            padding: 12px;
            border-radius: 10px;
            font-size: 15px;
            color: #003300;
            outline: none;
        }

        .btn-primary {
            width: 100%;
            background: #004d00;
            color: white;
            padding: 14px;
            border: none;
            border-radius: 25px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 20px;
            text-align: center;
        }

        /* Modal Overlay */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            padding: 20px;
        }

        .modal-box {
            background: white;
            color: #333;
            width: 100%;
            max-width: 320px;
            padding: 25px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
        }

        .modal-icon {
            width: 60px; height: 60px;
            background: #ffb300;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto 15px;
            color: white;
            font-size: 28px;
        }

        .modal-box h3 {
            margin-bottom: 10px;
            color: #003300;
        }

        .modal-box p {
            font-size: 13px;
            color: #666;
            margin-bottom: 20px;
        }

        /* Settings Screen Styles */
        .settings-profile {
            background: #004d00;
            padding: 20px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
        }

        .settings-item {
            background: #d4edda;
            color: #003300;
            padding: 15px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 12px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
        }

        /* Bottom Nav */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 100%;
            max-width: 400px;
            background-color: white;
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            box-shadow: 0 -4px 10px rgba(0,0,0,0.1);
            z-index: 500;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #666;
            font-size: 11px;
            gap: 4px;
            cursor: pointer;
            background: none;
            border: none;
        }

        .nav-item.active {
            color: #006400;
            font-weight: bold;
        }

        .nav-item i {
            font-size: 18px;
        }
    </style>
</head>
